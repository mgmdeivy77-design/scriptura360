# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Configure in Settings > Secrets (AI Studio) or Environment Variables (Vercel).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional override for the Gemini model used by /api/*.
# Defaults to "gemini-4-hydrogen".
# GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Optional public URL of the deployed application.
APP_URL="MY_APP_URL"
